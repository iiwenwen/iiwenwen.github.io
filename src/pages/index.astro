---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteConfig from "../data/site.json";
import { formatDate } from "../lib/date";
import { getPostDate, getPostFileSlug, getPublishedPosts } from "../lib/posts";
import { getMurDate, getMurTitle, getPublishedMurEntries } from "../lib/mur";

const baseUrl = import.meta.env.BASE_URL;

const posts = await getPublishedPosts();
const murEntries = await getPublishedMurEntries();
const timelineItems = [
  ...posts
    .filter((post) => post.data.category === "article")
    .map((post) => ({
      kind: "article" as const,
      title: post.data.title,
      date: getPostDate(post),
      link: `${baseUrl}blog/${getPostFileSlug(post)}/`
    })),
  ...murEntries.map((entry) => ({
    kind: "daily" as const,
    title: getMurTitle(entry),
    date: getMurDate(entry),
    link: `${baseUrl}mur/${entry.slug}/`
  }))
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 20);
---

<BaseLayout title={siteConfig.author} description={siteConfig.tagline}>
  <section class="hero">
    <h1 class="hero-brand">{siteConfig.author}</h1>
    <p class="hero-tagline">{siteConfig.tagline}</p>
    {siteConfig.quote && (
      <blockquote class="hero-quote">{siteConfig.quote}</blockquote>
    )}
  </section>

  <section class="home-timeline" aria-label="近期轨迹">
    {timelineItems.length === 0 ? (
      <p class="home-empty">还没动笔，纸还是空白的。</p>
    ) : (
      <ul class="timeline-list">
        {timelineItems.map((item) => {
          const isDaily = item.kind === "daily";
          return (
            <li class="timeline-item">
              <a href={item.link}>
                <span class="timeline-content">
                  <span class={`timeline-tag ${isDaily ? 'tag-daily' : 'tag-article'}`}>{isDaily ? '日常' : '文章'}</span>
                  {item.title}
                </span>
                <time datetime={item.date.toISOString()}>
                  {formatDate(item.date)}
                </time>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 28px;
  }

  .hero-brand {
    font-size: 2rem;
    font-weight: 500;
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-serif);
  }

  .hero-tagline {
    max-width: 720px;
    margin-top: 16px;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .home-timeline {
    margin-bottom: 50px;
  }

  .home-empty {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 40px;
  }

  .timeline-list {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .timeline-item {
    border-bottom: 1px dashed var(--border-subtle);
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-item a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    text-decoration: none;
    color: var(--text-primary);
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1), transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-item a:hover {
    color: var(--text-primary);
    transform: translateX(4px);
  }

  .timeline-content {
    font-weight: 400;
    line-height: 1.5;
    font-size: 1.02rem;
  }

  .timeline-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    margin-right: 12px;
    font-size: 0.75rem;
    vertical-align: text-bottom;
    letter-spacing: 0.02em;
  }

  .tag-article {
    background: #e4ecf5;
    color: var(--accent-primary);
  }

  .tag-daily {
    background: #e8e6dc;
    color: var(--text-soft);
  }

  .timeline-item time {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 42px;
    }

    .timeline-item a {
      display: grid;
      gap: 8px;
      padding: 16px 0;
    }

    .timeline-item time {
      padding-left: 54px;
    }
  }
</style>
