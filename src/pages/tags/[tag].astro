---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PostArchiveList from "../../components/PostArchiveList.astro";
import { getPostsByTag, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tagSet.add(tag);
    }
  }

  return [...tagSet].map((tag) => ({
    params: { tag }
  }));
}

const tag = Astro.params.tag!;
const posts = await getPostsByTag(tag);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`#${tag}`} description={`共 ${posts.length} 篇文章`}>
  <article class="post">
    <Breadcrumb items={[{ label: "标签", href: `${baseUrl}tags/` }, { label: `#${tag}` }]} />
    <header class="post-header">
      <p class="eyebrow">标签</p>
      <h1>#{tag}</h1>
      <p class="description">共 {posts.length} 篇文章</p>
    </header>
    <PostArchiveList posts={posts} />
  </article>
</BaseLayout>
