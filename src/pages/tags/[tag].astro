---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/date";
import { getPostDate, getPostsByTag, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      tagSet.add(tag);
    }
  }

  return [...tagSet].map((tag) => ({
    params: { tag }
  }));
}

const { tag } = Astro.params;

const posts = await getPostsByTag(tag!);

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`#${tag}`} description={`共 ${posts.length} 篇文章`}>
  <article class="post">
    <header class="post-header">
      <p class="eyebrow">标签</p>
      <h1>#{tag}</h1>
      <p class="description">共 {posts.length} 篇文章</p>
    </header>
    <ul class="archive-list">
      {posts.map((post) => (
        <li>
          <a href={`${baseUrl}blog/${post.slug}/`}>
            <time datetime={getPostDate(post).toISOString()}>
              {formatDate(getPostDate(post))}
            </time>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
