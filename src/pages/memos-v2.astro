---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostsByCategory } from "../lib/posts";

const entries = (await getPostsByCategory("daily"))
  .filter((e) => !e.data.draft)
  .sort(
    (a, b) => new Date(b.data.date ?? 0).valueOf() - new Date(a.data.date ?? 0).valueOf()
  );

interface DailyEntry { date: string; content: string; tags: string[] }

const memos: DailyEntry[] = entries.map((e) => {
  const content = e.body?.trim() ?? "";
  const date = e.data.date instanceof Date
    ? e.data.date.toISOString().slice(0, 16).replace("T", " ")
    : String(e.data.date ?? "");
  const tags = (content.match(/#([^\s#,，。\n]+)/g) || []).map((t: string) => t.slice(1));
  return { date, content, tags };
});

const tagCount = new Map<string, number>();
memos.forEach((m) => m.tags.forEach((t) => tagCount.set(t, (tagCount.get(t) || 0) + 1)));
const sortedTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="日常 V2（本地文件）" description="日常随想 · 静态生成">
  <article class="post">
    <header class="post-header">
      <h1>日常 <small style="color:#888;font-size:0.7em">V2 本地版</small></h1>
      <p class="description">基于本地 Markdown 文件，构建时静态生成</p>
    </header>

    {
      sortedTags.length > 0 && (
        <div class="memos-filter">
          <span class="filter-label">标签：</span>
          <div class="memos-tag-cloud">
            {sortedTags.map(([tag, count]) => (
              <a href="#" class="memo-tag-chip">#{tag}<small>{count}</small></a>
            ))}
          </div>
        </div>
      )
    }

    <div class="memos">
      {
        memos.length === 0 ? <p>暂无内容。</p> : (
          memos.map((memo) => (
            <div class="memo-item">
              <div class="memo-content">
                {memo.content.replace(/\n/g, "<br />")}
              </div>
              {memo.tags.length > 0 && (
                <div class="memo-tags">
                  {memo.tags.map((t) => (
                    <span class="memo-tag">#{t}</span>
                  ))}
                </div>
              )}
              <div class="memo-meta">
                <time>{memo.date}</time>
              </div>
            </div>
          ))
        )
      }
    </div>

    <p class="memo-count-info" style="text-align:center;color:var(--muted);font-size:0.85rem;margin-top:24px">
      共 {memos.length} 条日常
    </p>
  </article>
</BaseLayout>
