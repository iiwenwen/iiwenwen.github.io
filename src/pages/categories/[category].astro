---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import MediaCategoryPage from "../../components/MediaCategoryPage.astro";
import PostArchiveList from "../../components/PostArchiveList.astro";
import booksData from "../../data/books.json";
import moviesData from "../../data/movies.json";
import { getPostsByCategory, getPublishedPosts } from "../../lib/posts";

const categoryLabels: Record<string, string> = {
  article: "文章",
  book: "图书",
  movie: "电影"
};

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const categories = new Set<string>();
  for (const post of posts) {
    categories.add(post.data.category);
  }

  // Always include book/movie from JSON data
  if (booksData.length > 0) categories.add("book");
  if (moviesData.length > 0) categories.add("movie");

  return [...categories].map((cat) => ({
    params: { category: cat }
  }));
}

const category = Astro.params.category!;
const label = categoryLabels[category] ?? category;
const isMedia = category === "book" || category === "movie";
const posts = isMedia ? [] : await getPostsByCategory(category);
const entryCount = posts.length;
---

{isMedia ? (
  <MediaCategoryPage category={category} page={1} />
) : (
  <BaseLayout title={label} description={`共 ${entryCount} 篇${label}`}>
    <article class="post">
      <Breadcrumb items={[{ label }]} />
      <header class="post-header">
        <h1>{label}</h1>
        <p class="description">共 {entryCount} 篇</p>
      </header>
      <PostArchiveList posts={posts} />
    </article>
  </BaseLayout>
)}
