---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="日常" description="日常随想 · Memos">
  <article class="post">
    <header class="post-header">
      <h1>日常</h1>
      <p class="description">随手记录，碎片思考</p>
    </header>

    <div id="memos-tag-filter" class="memos-filter" style="display:none">
      <span class="filter-label">筛选：</span>
      <span id="memos-tag-active" class="filter-active" style="display:none">
        <a href="#" id="memos-tag-clear">✕ 清除</a>
      </span>
      <div id="memos-tag-cloud" class="memos-tag-cloud"></div>
    </div>

    <div id="memos" class="memos"></div>
    <button id="memos-load-more" class="ticket-btn-more" style="display:none">加载更多</button>
  </article>
</BaseLayout>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
<script is:inline>
  (function () {
    const MEMOS_HOST = "https://memos.syaoran.me";
    const LIMIT = 10;

    let pageToken = "";
    let activeTag = "";
    let allTags = new Map();

    const container = document.getElementById("memos");
    const loadBtn = document.getElementById("memos-load-more");
    const filterBar = document.getElementById("memos-tag-filter");
    const tagCloud = document.getElementById("memos-tag-cloud");
    const tagActive = document.getElementById("memos-tag-active");
    const tagClear = document.getElementById("memos-tag-clear");

    if (!container || !loadBtn || !filterBar || !tagCloud || !tagActive || !tagClear) return;

    function parseTags(text) {
      return (text.match(/#([^\s#,，。\n]+)/g) || []).map((t) => t.slice(1));
    }

    function formatTime(t) {
      const d = new Date(t);
      const now = new Date();
      const diff = now.valueOf() - d.valueOf();
      if (diff < 60000) return "刚刚";
      if (diff < 3600000) return Math.floor(diff / 60000) + "分钟前";
      if (diff < 86400000) return Math.floor(diff / 3600000) + "小时前";
      if (diff < 604800000) return Math.floor(diff / 86400000) + "天前";
      return d.toLocaleDateString("zh-CN");
    }

    function renderMarkdown(text) {
      // Remove tags from markdown rendering, we display them separately
      const clean = text.replace(/#([^\s#,，。\n]+)/g, "");
      const purifier = window.DOMPurify;
      if (typeof marked !== "undefined") {
        const html = marked.parse(clean);
        return purifier ? purifier.sanitize(html) : html;
      }
      const escaped = clean
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
      return escaped.replace(/\n/g, "<br>");
    }

    function updateTagCloud() {
      if (allTags.size === 0) {
        filterBar.style.display = "none";
        return;
      }
      filterBar.style.display = "block";
      const sorted = [...allTags.entries()].sort((a, b) => b[1] - a[1]);
      tagCloud.replaceChildren();
      for (const [tag, count] of sorted) {
        const link = document.createElement("a");
        link.href = "#";
        link.className = `memo-tag-chip${tag === activeTag ? " active" : ""}`;
        link.dataset.tag = tag;
        link.append(document.createTextNode(`#${tag}`));
        const small = document.createElement("small");
        small.textContent = String(count);
        link.appendChild(small);
        tagCloud.appendChild(link);
      }

      if (activeTag) {
        tagActive.style.display = "inline";
        const activeLink = tagActive.querySelector("a");
        if (activeLink) activeLink.textContent = "✕ #" + activeTag;
      } else {
        tagActive.style.display = "none";
      }
    }

    function renderMemos(data) {
      for (const m of data) {
        const content = m.content || "";
        const tags = parseTags(content);
        const time = formatTime(m.createTime);
        const memoId = m.name ? m.name.replace("memos/", "") : "";

        // Collect tags
        tags.forEach((t) => {
          allTags.set(t, (allTags.get(t) || 0) + 1);
        });

        const li = document.createElement("li");
        li.className = "memo-item";

        const body = document.createElement("div");
        body.className = "memo-content";
        body.innerHTML = renderMarkdown(content);
        li.appendChild(body);

        if (tags.length > 0) {
          const tagWrap = document.createElement("div");
          tagWrap.className = "memo-tags";
          tags.forEach((t) => {
            const span = document.createElement("span");
            span.className = "memo-tag";
            const link = document.createElement("a");
            link.href = "#";
            link.dataset.tag = t;
            link.textContent = `#${t}`;
            span.appendChild(link);
            tagWrap.appendChild(span);
          });
          li.appendChild(tagWrap);
        }

        const meta = document.createElement("div");
        meta.className = "memo-meta";
        const timeEl = document.createElement("time");
        timeEl.textContent = time;
        meta.appendChild(timeEl);
        if (memoId) {
          const link = document.createElement("a");
          link.href = `${MEMOS_HOST}/m/${encodeURIComponent(memoId)}`;
          link.target = "_blank";
          link.rel = "noopener";
          link.className = "memo-link";
          link.textContent = "Memos";
          meta.appendChild(link);
        }
        li.appendChild(meta);
        container.appendChild(li);
      }
    }

    function fetchMemos(token = "") {
      let url = `${MEMOS_HOST}/api/v1/memos?creatorId=1&pageSize=${LIMIT}`;
      if (token) url += `&pageToken=${token}`;
      if (activeTag) url += `&filter=${encodeURIComponent(`tag in ["${activeTag}"]`)}`;
      return fetch(url).then((r) => r.json());
    }

    function clearAndReload() {
      container.innerHTML = "";
      pageToken = "";
      allTags.clear();
      fetchMemos().then((data) => {
        const memos = data.memos ?? (Array.isArray(data) ? data : []);
        renderMemos(memos);
        updateTagCloud();
        pageToken = data.nextPageToken || (memos.length >= LIMIT ? (memos[memos.length - 1]?.name || "") : "");
        loadBtn.style.display = pageToken ? "block" : "none";
      }).catch(() => {});
    }

    // Init
    fetchMemos().then((data) => {
      const memos = data.memos ?? (Array.isArray(data) ? data : []);
      renderMemos(memos);
      updateTagCloud();
      // Use last memo's name as page token for next page
      pageToken = data.nextPageToken || (memos.length >= LIMIT && memos.length > 0 ? memos[memos.length - 1]?.name || "" : "");
      if (pageToken) {
        loadBtn.style.display = "block";
      }
    }).catch(() => {
      container.textContent = "加载失败";
    });

    loadBtn.addEventListener("click", () => {
      loadBtn.textContent = "加载中...";
      fetchMemos(pageToken).then((data) => {
        const memos = data.memos ?? (Array.isArray(data) ? data : []);
        renderMemos(memos);
        updateTagCloud();
        pageToken = data.nextPageToken || (memos.length >= LIMIT && memos.length > 0 ? memos[memos.length - 1]?.name || "" : "");
        loadBtn.textContent = pageToken ? "加载更多" : "没有更多了";
        if (!pageToken) loadBtn.style.display = "none";
      }).catch(() => {
        loadBtn.textContent = "加载失败";
      });
    });

    // Tag click
    document.addEventListener("click", (e) => {
      const tagLink = e.target instanceof Element ? e.target.closest("[data-tag]") : null;
      if (tagLink) {
        e.preventDefault();
        activeTag = tagLink.dataset.tag;
        clearAndReload();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });

    // Clear filter
    tagClear.addEventListener("click", (e) => {
      e.preventDefault();
      activeTag = "";
      clearAndReload();
    });
  })();
</script>
