---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostsByCategory, getPostDate } from "../lib/posts";
import { formatDate } from "../lib/date";

const entries = await getPostsByCategory("daily");
const baseUrl = import.meta.env.BASE_URL;

const memos = entries.map(post => {
  const date = getPostDate(post);
  const image = post.data.image || `${baseUrl}logo.png`;
  
  let excerpt = post.data.description;
  if (!excerpt) {
    excerpt = post.body
      .replace(/[#*~>\-]/g, "")
      .replace(/`/g, "")
      .replace(/\n/g, " ")
      .trim()
      .slice(0, 80) + "...";
  }

  return {
    ...post,
    slug: post.slug,
    title: post.data.title,
    date,
    image,
    excerpt
  };
});
---

<BaseLayout title="随记周刊" description="以周为单位，每天写入，每周发出">
  <div class="weekly-container">
    <header class="weekly-header">
      <h1>随记周刊</h1>
      <p>以周为单位，每天写入，每周发出，给自己一个倒逼的习惯。</p>
    </header>

    <div class="weekly-grid">
      {memos.length === 0 ? <p class="empty">暂无周刊发布。</p> : memos.map(memo => (
        <a href={`${baseUrl}blog/${memo.slug}/`} class="weekly-card">
          <div class="card-image">
            <img src={memo.image} alt={memo.title} loading="lazy" />
          </div>
          <div class="card-body">
            <div class="card-meta">
              <h2 class="card-title">{memo.title}</h2>
              <time class="card-date">{formatDate(memo.date)}</time>
            </div>
            <p class="card-excerpt">{memo.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .weekly-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 20px 0 60px;
    animation: fadeInUp 0.4s ease-out;
  }
  
  .weekly-header {
    text-align: left;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px dashed var(--border-subtle);
  }
  
  .weekly-header h1 {
    font-size: 2rem;
    font-family: var(--font-serif);
    color: var(--text-primary);
    margin: 0 0 10px 0;
  }
  
  .weekly-header p {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0;
  }
  
  .weekly-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  
  .weekly-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    box-shadow: var(--shadow-card);
  }
  
  .weekly-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    border-color: var(--accent-primary);
  }
  
  .card-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  
  .weekly-card:hover .card-image img {
    transform: scale(1.03);
  }
  
  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  
  .card-title {
    margin: 0;
    font-size: 1.15rem;
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s;
  }
  
  .weekly-card:hover .card-title {
    color: var(--accent-primary);
  }
  
  .card-date {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    flex-shrink: 0;
  }
  
  .card-excerpt {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .empty {
    text-align: center;
    color: var(--text-muted);
    grid-column: 1 / -1;
    padding: 40px 0;
  }

  @media (max-width: 640px) {
    .weekly-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
