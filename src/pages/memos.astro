---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/date";
import { getPostsByCategory } from "../lib/posts";

const entries = await getPostsByCategory("daily");

interface MemoItem { date: string; content: string; tags: string[]; slug: string }

const memos: MemoItem[] = entries.map((e) => {
  const content = e.body?.trim() ?? "";
  const date = e.data.pubDate ?? e.data.date;
  const dateStr = date instanceof Date
    ? date.toISOString().slice(0, 16).replace("T", " ")
    : String(date ?? "");
  const tags = (content.match(/#([^\s#,，。\n]+)/g) || []).map((t: string) => t.slice(1));
  return { date: dateStr, content, tags, slug: e.slug };
});

const tagCount = new Map<string, number>();
memos.forEach((m) => m.tags.forEach((t) => tagCount.set(t, (tagCount.get(t) || 0) + 1)));
const sortedTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="随记" description="随手记录，碎片思考">
  <article class="post">
    <header class="post-header">
      <h1>随记</h1>
      <p class="description">随手记录日常，碎片化思考</p>
    </header>

    <nav class="post-nav" style="margin-bottom:16px">
      <a href={`${baseUrl}write/`} style="font-size:0.9rem">写随记</a>
    </nav>

    {
      sortedTags.length > 0 && (
        <div class="memos-filter">
          <div class="memos-tag-cloud" id="tag-cloud">
            {sortedTags.map(([tag, count]) => (
              <a href="#" class="memo-tag-chip" data-tag={tag}>#{tag}<small>{count}</small></a>
            ))}
          </div>
        </div>
      )
    }

    <div class="memos">
      {
        memos.length === 0 ? <p>暂无内容。</p> : (
          memos.map((memo) => (
            <div class="memo-item" data-tags={memo.tags.join(",")}>
              <div class="memo-content">
                {memo.content.replace(/#([^\s#,，。\n]+)/g, "").replace(/\n/g, "<br />")}
              </div>
              {memo.tags.length > 0 && (
                <div class="memo-tags">
                  {memo.tags.map((t) => (
                    <span class="memo-tag">#{t}</span>
                  ))}
                </div>
              )}
              <div class="memo-meta">
                <time>{memo.date}</time>
              </div>
            </div>
          ))
        )
      }
    </div>

    <p style="text-align:center;color:var(--muted);font-size:0.85rem;margin-top:24px">
      共 {memos.length} 条随记
    </p>
  </article>
</BaseLayout>

<script>
  // Client-side tag filtering
  const tagCloud = document.getElementById("tag-cloud");
  if (tagCloud) {
    tagCloud.addEventListener("click", (e) => {
      const chip = (e.target as Element).closest("[data-tag]");
      if (!chip) return;
      e.preventDefault();
      const tag = (chip as HTMLElement).dataset.tag;
      const active = chip.classList.contains("active");

      // Toggle active state
      tagCloud.querySelectorAll(".memo-tag-chip").forEach(c => c.classList.remove("active"));
      if (!active) chip.classList.add("active");

      // Filter memos
      document.querySelectorAll(".memo-item").forEach((item) => {
        const tags = (item as HTMLElement).dataset.tags?.split(",").filter(Boolean) || [];
        if (!active && tag && !tags.includes(tag)) {
          (item as HTMLElement).style.display = "none";
        } else {
          (item as HTMLElement).style.display = "";
        }
      });
    });
  }
</script>
