---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PostArchiveList from "../../components/PostArchiveList.astro";
import { getPostsByColumn, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const columns = new Set<string>();
  for (const post of posts) {
    for (const col of post.data.categories) columns.add(col);
  }
  return [...columns].map((col) => ({ params: { column: col } }));
}

const column = Astro.params.column!;
const baseUrl = import.meta.env.BASE_URL;

const columnPosts = await getPostsByColumn(column);
---

<BaseLayout title={`${column}`} description={`${column} 专栏`}>
  <article class="post">
    <Breadcrumb items={[{ label: "专栏", href: `${baseUrl}columns/` }, { label: column }]} />
    <header class="post-header">
      <h1>{column}</h1>
    </header>
    <PostArchiveList posts={columnPosts} />
  </article>
</BaseLayout>
