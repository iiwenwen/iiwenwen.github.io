---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/date";
import { getPostDate, getPostsByColumn, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const columns = new Set<string>();
  for (const post of posts) {
    for (const col of post.data.categories) columns.add(col);
  }
  return [...columns].map((col) => ({ params: { column: col } }));
}

const { column } = Astro.params;
const baseUrl = import.meta.env.BASE_URL;

const columnPosts = await getPostsByColumn(column!);
---

<BaseLayout title={`${column}`} description={`${column} 专栏`}>
  <article class="post">
    <nav class="breadcrumb">
      <a href={baseUrl}>首页</a>
      <span>/</span>
      <a href={`${baseUrl}columns/`}>专栏</a>
      <span>/</span>
      <span>{column}</span>
    </nav>
    <header class="post-header">
      <h1>{column}</h1>
    </header>
    <ul class="archive-list">
      {columnPosts.map((post) => (
        <li>
          <a href={`${baseUrl}blog/${post.slug}/`}>
            <time datetime={getPostDate(post).toISOString()}>
              {formatDate(getPostDate(post))}
            </time>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
