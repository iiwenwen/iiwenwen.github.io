---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { formatDate } from "../lib/date";
import { getPublishedPoetry } from "../lib/poetry";

const baseUrl = import.meta.env.BASE_URL;
const poetryEntries = await getPublishedPoetry();
const allPoems = await Promise.all(
  poetryEntries.map(async (entry, index) => ({
    type: entry.data.kind,
    date: entry.data.date,
    Content: (await entry.render()).Content,
    bgImg: (index % 8) + 1
  }))
);
---

<BaseLayout title="诗歌" description="俳句与诗歌">
  <article class="post">
    <Breadcrumb items={[{ label: "诗歌" }]} />
    <header class="post-header">
      <h1>诗歌</h1>
      <p class="description">让我为你读首诗</p>
    </header>

    <div class="poetry-list">
      {allPoems.length === 0 ? (
        <p class="poetry-loading">暂无诗歌。</p>
      ) : (
        allPoems.map(({ type, date, Content, bgImg }) => {
          const hasDate = date.valueOf() > 0;
          
          return (
            <article class="poetry-card" style={`--poetry-card-image: url('${baseUrl}poetry/${bgImg}.webp')`}>
              <div class="pcard-main">
                <div class="pcard-body">
                  <Content />
                </div>
                <div class="pcard-foot">
                  <time datetime={hasDate ? date.toISOString() : undefined}>
                    {hasDate ? formatDate(date) : "未注明日期"}
                  </time>
                  <span style="opacity: 0.6"> · {type === 'haiku' ? '俳句' : '诗歌'}</span>
                </div>
              </div>
            </article>
          );
        })
      )}
    </div>
  </article>
</BaseLayout>

<style is:global>
  .poetry-list { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .poetry-loading { text-align: center; color: var(--text-muted); }

  .poetry-card {
    display: flex; flex-direction: column; min-height: 100px; width: min(100%, 540px);
    border-radius: 14px; overflow: hidden;
    background: var(--surface-card);
    box-shadow: var(--poetry-card-shadow);
    position: relative; isolation: isolate;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .poetry-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px oklch(0% 0 0 / 4%);
  }
  .poetry-card::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: var(--poetry-card-image, none) center / cover no-repeat;
    opacity: 0.22;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .poetry-card:hover::before {
    opacity: 0.35;
    transform: scale(1.03);
  }
  .poetry-card::after {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(135deg, transparent 40%, oklch(76% 0.11 245 / 8%) 100%);
    pointer-events: none;
  }
  .pcard-main {
    flex: 1; display: flex; flex-direction: column; min-width: 0; width: 100%;
  }
  .pcard-body {
    flex: 1; padding: 18px 20px 0;
    font-family: var(--font-serif);
    font-size: 1.1rem; line-height: 2; color: var(--text-primary);
    overflow-wrap: break-word; word-break: break-word;
  }
  .pcard-body p { margin: 0.3em 0; }
  .pcard-foot {
    padding: 12px 20px 14px;
    font-size: 0.78rem; color: var(--text-muted);
    font-family: var(--font-mono);
  }
  @media (max-width: 640px) {
    .poetry-card { flex-direction: column; }
    .pcard-body { font-size: 1rem; padding: 16px 18px 0; }
  }
</style>
