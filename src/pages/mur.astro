---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { formatDate } from "../lib/date";
import { getMurDate, getMurExcerpt, getMurTitle, getPublishedMurEntries } from "../lib/mur";

const entries = await getPublishedMurEntries();
const baseUrl = import.meta.env.BASE_URL;

const murItems = entries.map(entry => {
  return {
    ...entry,
    title: getMurTitle(entry),
    date: getMurDate(entry),
    excerpt: getMurExcerpt(entry)
  };
});
---

<BaseLayout title="日常" description="日常片段与阶段随记">
  <article class="post">
    <Breadcrumb items={[{ label: "日常" }]} />
    <header class="post-header">
      <h1>日常</h1>
      <p class="description">生活片段、阶段随记，以及正在发生的琐碎变化。</p>
    </header>

    {murItems.length === 0 ? (
      <p class="mur-empty">暂无日常。</p>
    ) : (
      <ul class="mur-list">
        {murItems.map(item => (
          <li>
            <a href={`${baseUrl}mur/${item.slug}/`}>
              <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
              <span class="mur-item-body">
                <span class="mur-item-title">{item.title}</span>
                <span class="mur-item-excerpt">{item.excerpt}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  .mur-list {
    max-width: 660px;
    padding: 0;
    margin: 0 auto;
    list-style: none;
  }

  .mur-list li {
    padding: 12px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .mur-list li:first-child {
    border-top: 0;
  }

  .mur-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: baseline;
    color: var(--text-primary);
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mur-list a:hover {
    transform: translateX(4px);
  }

  .mur-list time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .mur-item-body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .mur-item-title {
    font-size: 1rem;
    line-height: 1.55;
  }

  .mur-item-excerpt {
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .mur-empty {
    max-width: 660px;
    margin: 0 auto;
    color: var(--text-muted);
    padding: 40px 0;
  }

  @media (max-width: 640px) {
    .mur-list a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
