---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { formatDate } from "../../lib/date";
import { getPublishedPoetry } from "../../lib/poetry";

export async function getStaticPaths() {
  const poetryEntries = await getPublishedPoetry();

  return poetryEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL;
const allEntries = await getPublishedPoetry();
const currentIndex = allEntries.findIndex((item) => item.slug === entry.slug);
const prevEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
const nextEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const entryDate = entry.data.date;
const meta = [
  entry.data.kind === "haiku" ? "俳句" : "诗歌",
  formatDate(entryDate),
  entry.data.source ? `来源：${entry.data.source}` : ""
].filter(Boolean);
---

<BaseLayout title={entry.data.title} description={`诗歌：${entry.data.title}`}>
  <article class="voice-poem">
    <Breadcrumb items={[{ label: "诗歌", href: `${baseUrl}poetry/` }, { label: entry.data.title }]} />
    <header class="voice-poem-header">
      <p class="eyebrow">{entry.data.kind === "haiku" ? "俳句" : "诗歌"}</p>
      <h1>{entry.data.title}</h1>
      {meta.length > 0 && <div class="meta">{meta.map((item) => <span>{item}</span>)}</div>}
    </header>

    <section class="poem-paper" aria-label="诗歌正文">
      <div class="poem-text">
        <Content />
      </div>
    </section>

    <nav class="post-nav" aria-label="上下首导航">
      {
        prevEntry && (
          <a class="post-nav-link prev" href={`${baseUrl}poems/${prevEntry.slug}/`}>
            <span class="post-nav-label">上一首</span>
            <span class="post-nav-title">{prevEntry.data.title}</span>
          </a>
        )
      }
      {
        nextEntry && (
          <a class="post-nav-link next" href={`${baseUrl}poems/${nextEntry.slug}/`}>
            <span class="post-nav-label">下一首</span>
            <span class="post-nav-title">{nextEntry.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
