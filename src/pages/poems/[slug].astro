---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { formatDate } from "../../lib/date";
import { getPublishedPoetry } from "../../lib/poetry";

export async function getStaticPaths() {
  const poetryEntries = await getPublishedPoetry();

  return poetryEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL;
const allEntries = await getPublishedPoetry();
const currentIndex = allEntries.findIndex((item) => item.slug === entry.slug);
const prevEntry = currentIndex > 0 ? allEntries[currentIndex - 1] : null;
const nextEntry = currentIndex < allEntries.length - 1 ? allEntries[currentIndex + 1] : null;
const entryDate = entry.data.date;
const formattedDate = formatDate(entryDate);
const supportingMeta = [
  entry.data.kind === "haiku" ? "俳句" : "诗歌",
  entry.data.duration ? `时长：${entry.data.duration}` : ""
].filter(Boolean);
const normalizePoemLine = (value: string) => value
  .replace(/^#+\s*/, "")
  .replace(/[\s，。！？、；：,.!?;:'"“”‘’《》〈〉【】（）()—–_-]/g, "")
  .toLowerCase();
const firstPoemLine = entry.body
  .split(/\r?\n/)
  .map((line) => line.trim())
  .find((line) => line.length > 0) ?? "";
const titleRepeatsFirstLine = normalizePoemLine(entry.data.title) === normalizePoemLine(firstPoemLine);
---

<BaseLayout title={entry.data.title} description={`诗歌：${entry.data.title}`}>
  <article class="voice-poem">
    <Breadcrumb items={[{ label: "诗歌", href: `${baseUrl}poetry/` }]} />

    <section
      class:list={["poem-reading", { "title-repeats-first-line": titleRepeatsFirstLine }]}
      aria-label={entry.data.audioUrl ? "诗歌朗读和正文" : "诗歌正文"}
    >
      <h1 class:list={{ "visually-hidden": titleRepeatsFirstLine }}>{entry.data.title}</h1>
      {
        entry.data.audioUrl && (
          <div class="poem-audio">
            <audio controls preload="metadata" aria-label={`播放《${entry.data.title}》朗读`}>
              <source src={entry.data.audioUrl} type={entry.data.audioType} />
              你的浏览器不支持音频播放。
            </audio>
          </div>
        )
      }
      <div class="poem-text">
        <Content />
      </div>
      <div class="poem-meta">
        <div class="poem-meta-context">{supportingMeta.map((item) => <span>{item}</span>)}</div>
        <time datetime={entryDate.toISOString()}>{formattedDate}</time>
      </div>
    </section>

    <nav class="post-nav" aria-label="上下首导航">
      {
        prevEntry && (
          <a class="post-nav-link prev" href={`${baseUrl}poems/${prevEntry.slug}/`}>
            <span class="post-nav-label">
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
                <path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              上一首
            </span>
            <span class="post-nav-title">{prevEntry.data.title}</span>
          </a>
        )
      }
      {!prevEntry && <span class="post-nav-empty" aria-hidden="true"></span>}
      {!nextEntry && <span class="post-nav-empty" aria-hidden="true"></span>}
      {
        nextEntry && (
          <a class="post-nav-link next" href={`${baseUrl}poems/${nextEntry.slug}/`}>
            <span class="post-nav-label">
              下一首
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="post-nav-title">{nextEntry.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
