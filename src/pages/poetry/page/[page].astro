---
import PoetryPage from "../../../components/PoetryPage.astro";
import { getPublishedPoetry, POETRY_PAGE_SIZE } from "../../../lib/poetry";

export async function getStaticPaths() {
  const poetryEntries = await getPublishedPoetry();
  const totalPages = Math.ceil(poetryEntries.length / POETRY_PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: { page }
    };
  });
}

const { page } = Astro.props as { page: number };
---

<PoetryPage page={page} />
