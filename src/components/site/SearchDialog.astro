<dialog id="search-modal" aria-label="搜索对话框" data-pagefind-ignore>
  <div class="search-modal-inner">
    <header class="search-modal-header">
      <span>搜索文章</span>
      <button class="search-modal-close" aria-label="关闭搜索" autofocus>&times;</button>
    </header>
    <div id="search"></div>
    <footer class="search-modal-footer">
      <kbd>Esc</kbd> 关闭 &middot; <kbd>Cmd/Ctrl+K</kbd> 打开
    </footer>
  </div>
</dialog>
