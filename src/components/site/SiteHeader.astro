---
import siteConfig from "../../data/site.json";

const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="brand" href={baseUrl}>
      <img src={`${baseUrl}logo.png`} alt="Logo" class="site-logo" />
      <span>{siteConfig.author}</span>
    </a>
    <nav aria-label="主导航">
      <a href={baseUrl}>首页</a>
      <a href={`${baseUrl}archive/`}>文章</a>
      <a href={`${baseUrl}columns/`}>专栏</a>
      <a href={`${baseUrl}mur/`}>日常</a>
      <a href={`${baseUrl}poetry/`}>诗歌</a>
      <a href={`${baseUrl}categories/book/`}>读书</a>
      <a href={`${baseUrl}categories/movie/`}>观影</a>
      <a href={`${baseUrl}about/`}>关于</a>
      <button class="search-trigger" title="搜索 (Cmd+K)" aria-label="打开搜索">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <span>搜索</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    addEventListener("scroll", () => {
      header.classList.toggle("scrolled", scrollY > 0);
    });
  }
</script>
