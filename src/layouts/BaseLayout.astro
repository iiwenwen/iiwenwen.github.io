---
import "../styles/index.css";

import siteConfig from "../data/site.json";
import SearchDialog from "../components/site/SearchDialog.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.author,
  description = "个人博客"
} = Astro.props;

const pageTitle = title === siteConfig.author ? title : `${title} | ${siteConfig.author}`;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="base-url" content={baseUrl} />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.author}的博客 RSS`} href={`${baseUrl}rss.xml`} />
    <link rel="stylesheet" href={`${baseUrl}pagefind/pagefind-ui.css`} />
    <script is:inline src={`${baseUrl}js/search.js`} defer></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <SearchDialog />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
