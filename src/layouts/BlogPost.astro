---
import type { CollectionEntry } from "astro:content";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedBooks from "../components/RelatedBooks.astro";
import { getBooksByIds } from "../lib/book-links";
import { getPostExcerpt, getPostFileSlug } from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"posts">;
  prevPost?: CollectionEntry<"posts"> | null;
  nextPost?: CollectionEntry<"posts"> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
const baseUrl = import.meta.env.BASE_URL;
const postDate = post.data.pubDate ?? post.data.date;
const description = getPostExcerpt(post);
const tags = post.data.tags;
const categoryLabels = {
  article: "文章"
} as const;
const oldCategories = post.data.categories;
const relatedBooks = getBooksByIds(post.data.books);
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={post.data.image}
  type="article"
>
  <article class="post">
    <Breadcrumb items={[{ label: "文章", href: `${baseUrl}archive/` }, { label: post.data.title }]} />
    <header class="post-header">
      <p class="eyebrow">{categoryLabels[post.data.category]}</p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="description">{post.data.description}</p>}
      <div class="meta">
        {postDate && (
          <time datetime={postDate.toISOString()}>
            {postDate.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric"
            })}
          </time>
        )}
        {oldCategories.length > 0 && (
          <span>{oldCategories.map((c) => `#${c}`).join(" ")}</span>
        )}
        {post.data.column && <span>专栏：<a href={`${baseUrl}columns/${post.data.column}/`}>{post.data.column}</a></span>}
        {tags.length > 0 && (
          <span>{tags.map((tag) => `#${tag}`).join(" ")}</span>
        )}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <RelatedBooks books={relatedBooks} />
    <nav class="post-nav" aria-label="上下篇导航">
      {
        prevPost && (
          <a class="post-nav-link prev" href={`${baseUrl}blog/${getPostFileSlug(prevPost)}/`}>
            <span class="post-nav-label">
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
                <path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              上一篇
            </span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </a>
        )
      }
      {!prevPost && <span class="post-nav-empty" aria-hidden="true"></span>}
      {!nextPost && <span class="post-nav-empty" aria-hidden="true"></span>}
      {
        nextPost && (
          <a class="post-nav-link next" href={`${baseUrl}blog/${getPostFileSlug(nextPost)}/`}>
            <span class="post-nav-label">
              下一篇
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
