{
  "name": "newblog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 bun --bun node_modules/.bin/astro dev",
    "build": "bun run clean:pagefind && bun run build:astro && bun run build:pagefind && bun run copy:pagefind",
    "build:astro": "ASTRO_TELEMETRY_DISABLED=1 bun --bun node_modules/.bin/astro build",
    "build:pagefind": "bun --bun node_modules/.bin/pagefind --site dist",
    "clean:pagefind": "rm -rf public/pagefind",
    "copy:pagefind": "cp -r dist/pagefind public/pagefind",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 bun --bun node_modules/.bin/astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 bun --bun node_modules/.bin/astro check",
    "audio:dev": "bunx wrangler dev --config wrangler.audio.jsonc",
    "audio:deploy": "bunx wrangler deploy --config wrangler.audio.jsonc",
    "audio:r2:create": "bunx wrangler r2 bucket create syaoran-poetry-audio",
    "sync:poetry": "bun scripts/sync-poetry-memos.mjs",
    "zotero:sync": "python3 scripts/convert_zotero.py --fetch",
    "douban:sync": "python3 scripts/sync_douban.py",
    "sync": "bun run douban:sync && bun run zotero:sync"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "pagefind": "^1.5.2",
    "remark-breaks": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
